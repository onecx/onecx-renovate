{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":disableDependencyDashboard",
        "group:monorepos",
        "group:recommended"
    ],
    "platformAutomerge": true,
    "packageRules": [
        {
            "matchManagers": ["github-actions"],
            "enabled": false
        },
        {
            "matchManagers": ["dockerfile"],
            "labels": ["docker-image"],
            "versioning": "docker",
            "automerge": true
        },
    ],
    "dependencyDashboard": false,
    "labels": ["renovate"]
}